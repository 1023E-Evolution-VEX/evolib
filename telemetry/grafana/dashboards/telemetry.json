{
  "uid": "evo-telemetry",
  "title": "EvoLib autonomous telemetry",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "VEX",
    "EvoLib"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Executed route (inches)",
      "description": "Recorded odometry, not ground truth. Heading zero is +Y, clockwise positive. Field center is (0, 0); boundaries are +/-72 inches. Pose resets can cause jumps.",
      "type": "xychart",
      "pluginVersion": "13.2.1",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "evo-sd"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "evo-sd"
          },
          "type": "csv",
          "source": "url",
          "url": "http://csv/${run:percentencode}",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "format": "table",
          "root_selector": "",
          "columns": [
            {
              "selector": "x_in",
              "text": "x_in",
              "type": "number"
            },
            {
              "selector": "y_in",
              "text": "y_in",
              "type": "number"
            }
          ],
          "csv_options": {
            "skip_empty_lines": true,
            "skip_lines_with_error": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthin",
          "custom": {
            "show": "lines",
            "lineWidth": 2,
            "pointSize": {
              "fixed": 3
            },
            "axisLabel": "Y (inches)"
          },
          "min": -72,
          "max": 72
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "x_in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthin"
              },
              {
                "id": "custom.axisLabel",
                "value": "X (inches)"
              },
              {
                "id": "min",
                "value": -72
              },
              {
                "id": "max",
                "value": 72
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "auto",
        "series": [
          {
            "x": {
              "matcher": {
                "id": "byName",
                "options": "x_in"
              }
            }
          }
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
